# Root ignores
node_modules/
.DS_Store
*.pem
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend specific ignores
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage/
frontend/.pnpm-debug.log*
frontend/.env*
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Backend specific ignores
backend/__pycache__/
backend/**/__pycache__/
backend/venv/
backend/.venv/
backend/*.pyc
backend/.env
# backend/models/*.pkl

# Docs (keep local only)
prd.md
design.md
techstack.md
todolist.md